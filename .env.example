# Copia a .env (o configúralas en Vercel). Nunca subas valores reales al repo.
SECRET_KEY=genera-una-con-python-c-import-secrets-print-secrets.token_urlsafe-50
DEBUG=False
# Opcional: PostgreSQL (p. ej. Neon). Sin esto se usa SQLite.
DATABASE_URL=postgres://usuario:password@host:5432/basededatos
# Opcional: hosts/orígenes extra separados por coma
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
